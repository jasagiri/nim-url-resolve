  ],
  "buildCommand": "nim c --hints:off -o:bin/tests/mt_resolve tests/external/test_resolve.nim && nim c --hints:off -o:bin/tests/mt_properties tests/external/test_properties.nim",
  "testCommand": "./bin/tests/mt_resolve && ./bin/tests/mt_properties",
  "mutators": [
    "AOR",
